# --- OpenClaw Enterprise Configuration Template (.env) ---

# --- 🚀 MODEL CONFIGURATION ---
# Options: openrouter, openai, anthropic, google (Gemini), ollama
LLM_PROVIDER=google
GOOGLE_API_KEY=YOUR_GEMINI_KEY_HERE

# --- 🛰️ NETWORK & ACCESS ---
# Bind to localhost for 100% security. Access via SSH Tunnel only.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000

# --- 🕵️ AIOPS INTELLIGENCE (Connectors) ---
# Enable Slack for real-time SRE alerts
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-YOUR_BOT_TOKEN
SLACK_APP_TOKEN=xapp-YOUR_APP_TOKEN

# --- 🧠 SEARCH & RESEARCH ---
# Enables the agent to research new error codes on the web
SEARCH_PROVIDER=google-search
GOOGLE_SEARCH_API_KEY=YOUR_SEARCH_KEY
GOOGLE_CX=YOUR_SEARCH_ENGINE_ID

# --- 💾 PERSISTENCE ---
# Use SQLite for lightweight cloud deployments
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/openclaw.db
